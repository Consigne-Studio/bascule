<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Bascule</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <!-- Métadonnées de l'API Selenium, chargées pour l'analyse sémantique des suites à migrer (jamais exécutées). -->
    <PackageReference Include="Selenium.WebDriver" Version="4.51.0" ExcludeAssets="build;buildTransitive;native" />
    <PackageReference Include="Selenium.Support" Version="4.51.0" />
    <PackageReference Include="DotNetSeleniumExtras.WaitHelpers" Version="3.11.0" />
    <PackageReference Include="DotNetSeleniumExtras.PageObjects.Core" Version="4.48.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Rapport\Ressources\*.woff2" LogicalName="Bascule.Rapport.Ressources.%(Filename)%(Extension)" WithCulture="false" />
    <InternalsVisibleTo Include="Bascule.Conversion" />
    <InternalsVisibleTo Include="Bascule.Tests" />
    <InternalsVisibleTo Include="bascule" />
  </ItemGroup>
</Project>
